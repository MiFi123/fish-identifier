NODE_ENV=development
# development, beta oder production
APP_ENV=development
# Nur hinter einem vertrauenswürdigen Reverse Proxy aktivieren.
TRUST_PROXY=false
# Für Hosting auf allen Interfaces belassen; lokal weiterhin über localhost erreichbar.
HOST=0.0.0.0

# Maximale Bildgröße (10 MiB)
MAX_UPLOAD_SIZE_BYTES=10485760

# Primärer KI-Anbieter. Weitere Anbieter können später ergänzt werden.
AI_PROVIDER=FISHIAL

# Einfacher Schutz vor vielen Anfragen von derselben IP-Adresse.
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_REQUESTS=10
SECOND_OPINION_RATE_LIMIT_WINDOW_MS=600000
SECOND_OPINION_RATE_LIMIT_MAX_REQUESTS=10

# Fishial Recognition API v2 – Zugangsdaten ausschließlich serverseitig.
FISHIAL_CLIENT_ID=
FISHIAL_CLIENT_SECRET=
# Nur ändern, wenn Fishial eine andere API-Basis vorgibt.
FISHIAL_BASE_URL=https://api-recognition.fishial.ai

# Optionale zweite KI-Analyse: wird nur bei Fishial-Ergebnissen unter 80 % aufgerufen.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SECOND_OPINION_PROVIDER=GEMINI
SECOND_OPINION_ENABLED=true
